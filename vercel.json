{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "buildCommand": "npm run build",
      "entrypoint": "dist/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "client"
      }
    }
  ]
}
