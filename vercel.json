{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "server",
      "installCommand": "cd .. && npm ci",
      "buildCommand": "npm run build:vercel",
      "entrypoint": "vercel-entry.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
